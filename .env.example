# Client-side public configuration (safe to bundle in Expo app)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY

# Server-only secrets (NEVER prefix with EXPO_PUBLIC_ — set via `supabase secrets set`)
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# AI_PROVIDER_API_KEY=your_llm_api_key_for_phase_5
